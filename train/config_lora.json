{
  "base_model": "Qwen/Qwen2.5-1.5B-Instruct",
  "method": "lora",
  "lora": {"r": 16, "alpha": 32, "dropout": 0.05, "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"]},
  "training": {
    "epochs": 2,
    "learning_rate": 0.0001,
    "lr_scheduler": "cosine",
    "warmup_ratio": 0.03,
    "cutoff_len": 4096,
    "per_device_batch_size": 1,
    "gradient_accumulation_steps": 8,
    "bf16": true,
    "gradient_checkpointing": true,
    "max_grad_norm": 1.0
  },
  "qlora": {"enable": false, "load_in_4bit": true, "quant_type": "nf4", "double_quant": true},
  "data": {"train": "data/out/train.jsonl", "valid": "data/out/valid.jsonl", "format": "messages"},
  "inference": {"temperature": 0.0, "max_new_tokens": 512, "system_prompt": "config/prompts.py:SYSTEM_PROMPT"}
}
